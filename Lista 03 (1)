#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main() {
    char palavra[100];
    char *dinamica;

    printf("Digite uma palavra: ");
    scanf("%99s", palavra);

    dinamica = malloc((strlen(palavra) + 1) * sizeof(char));

    strcpy(dinamica, palavra);

    printf("Palavra: %s\n", dinamica);

    free(dinamica);

    return 0;
}
