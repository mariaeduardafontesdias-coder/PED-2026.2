#include <stdio.h>

int somaDigitos(int n)
{
    if (n < 10)
    {
        return n;
    }

    return (n % 10) + somaDigitos(n / 10);
}

int main()
{
    int n;
    int resultado;

    printf("Digite um numero: ");
    scanf("%d", &n);

    resultado = somaDigitos(n);

    printf("Soma dos digitos: %d\n", resultado);

    return 0;
}