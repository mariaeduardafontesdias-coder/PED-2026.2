#include <stdio.h>

int contaDigitos(int n)
{
    if (n < 10)
    {
        return 1;
    }

    return 1 + contaDigitos(n / 10);
}

int main()
{
    int n;
    int resultado;

    printf("Digite um numero: ");
    scanf("%d", &n);

    resultado = contaDigitos(n);

    printf("Quantidade de digitos: %d\n", resultado);

    return 0;
}